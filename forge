#!/usr/bin/env bash

set -euo pipefail

# FORGE_DIR="/usr/local/share/forge"

FORGE_DIR="$(dirname "${BASH_SOURCE[0]}")"

source "$FORGE_DIR/engine/runner.sh"

VERSION="0.2.0"
export VERSION

show_help() {
    cat <<EOF

⚒ Forge $VERSION

Build your development environment.

Usage:

    forge build <profile>

Commands:

    build       Build a Forge environment
    version     Show Forge version
    help        Show this message

EOF
}

build() {
    PROFILE="${1:-}"

    if [[ -z "$PROFILE" ]]; then
        echo "Error: profile required"
        exit 1
    fi

    build_profile "$PROFILE"

}

case "${1:-help}" in

    build)
        build "$2"
        ;;

    version)
        echo "Forge $VERSION"
        ;;

    help)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;

esac
