#!/usr/bin/env bash

set -euo pipefail

FORGE_DIR="$(dirname "${BASH_SOURCE[0]}")"

VERSION="0.1.1"
export VERSION

source "$FORGE_DIR/engine/runner.sh"

show_help() {
    cat <<EOF

⚒ Forge $VERSION

Build your development environment.

Usage:

    forge build <profile>

Commands:

    build       Build a Forge environment
    version     Show Forge version
    help        Show this message

EOF
}

build() {

    local profile="${1:-}"

    if [[ -z "$profile" ]]; then
        echo "Error: profile required"
        return 1
    fi

    forge_execute_profile "$profile" || {
        echo
        echo "Forge failed."
        return 1
    }

}

case "${1:-help}" in

    build)
        build "$2"
        ;;

    version)
        echo "Forge $VERSION"
        ;;

    help)
        show_help
        ;;

    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;

esac
